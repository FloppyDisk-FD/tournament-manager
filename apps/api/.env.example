DATABASE_URL=postgres://postgres:postgres@localhost:5432/tournament_manager
JWT_SECRET=change-me-in-production
PORT=3001

# Waffo Pancake 支付网关（真实网关；不配置则 /pay 走 mock）
# 商户 ID：Dashboard → API & Development 顶部 copy 按钮（不是 storeId）
WAFFO_MERCHANT_ID=
# API Key 的 RSA 私钥：Dashboard → API & Development → API Keys
WAFFO_PRIVATE_KEY=
# 可选：SDK 自动创建后可固化
# WAFFO_STORE_ID=
# WAFFO_PRODUCT_ID=
