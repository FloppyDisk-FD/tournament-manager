{
  "name": "@tournament-manager/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:api": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/jwt": "^1.3.0",
    "@elysiajs/node": "^1.4.5",
    "@tournament-manager/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.3.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bun-types": "^1.2.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
